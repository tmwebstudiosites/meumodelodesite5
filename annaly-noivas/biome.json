{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!reports",
      "!.stryker-tmp",
      "!playwright-report",
      "!test-results",
      "!src/**/*.generated.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
